# ── Server ──────────────────────────────────────────────────────────────────

# TCP port the Colyseus/Express server listens on. Default: 3000
# PORT=3000

# SQLite database path (prefix must be "sqlite:"). Default: sqlite:./office.db
# DATABASE_URL=sqlite:/var/lib/agent-office/office.db

# Directory for the agent memory SQLite database. Default: ./data
# DATA_DIR=/var/lib/agent-office

# ── Ollama ───────────────────────────────────────────────────────────────────

# Base URL of the Ollama inference server. Default: http://localhost:11434
# OLLAMA_URL=http://localhost:11434

# ── Web Search ───────────────────────────────────────────────────────────────

# Tavily API key (optional) — enables Tavily web search for agents.
# When set, web_search calls use Tavily; otherwise DuckDuckGo is used as fallback.
# Get your key at https://app.tavily.com
TAVILY_API_KEY=
